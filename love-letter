
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A Letter For You</title>
  <link href="https://googleapis.com" rel="stylesheet">
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
      font-family: 'Playfair Display', serif;
      overflow: hidden;
    }

    /* Main Envelope Wrapper */
    .envelope-wrapper {
      position: relative;
      width: 320px;
      height: 220px;
      background: #d6336c;
      border-radius: 0 0 10px 10px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
      cursor: pointer;
    }

    /* Top Flap */
    .flap {
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 0;
      border-left: 160px solid transparent;
      border-right: 160px solid transparent;
      border-top: 120px solid #b52456;
      transform-origin: top;
      transition: transform 0.6s ease, z-index 0.6s;
      z-index: 4;
    }

    /* Left & Right Pocket Folds */
    .pocket {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 0;
      border-left: 160px solid #e64980;
      border-right: 160px solid #e64980;
      border-bottom: 110px solid #f06595;
      border-top: 110px solid transparent;
      border-radius: 0 0 10px 10px;
      z-index: 3;
    }

    /* Heart Seal */
    .seal {
      position: absolute;
      top: 95px;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 40px;
      background: #fff0f3;
      color: #d6336c;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 1.3rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      z-index: 5;
      transition: opacity 0.3s ease;
    }

    /* Hidden Letter Inside */
    .letter {
      position: absolute;
      bottom: 10px;
      left: 15px;
      width: 290px;
      height: 190px;
      background: #fffdf9;
      border-radius: 8px;
      padding: 20px;
      box-sizing: border-box;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      transition: transform 0.7s ease, height 0.7s ease, z-index 0.3s;
      z-index: 2;
      overflow: hidden;
    }

    .letter h2 {
      font-family: 'Caveat', cursive;
      color: #d6336c;
      margin: 0 0 10px 0;
      font-size: 1.6rem;
    }

    .letter p {
      font-size: 0.92rem;
      line-height: 1.5;
      color: #4a3b3e;
      margin: 0 0 12px 0;
    }

    .signature {
      font-family: 'Caveat', cursive;
      font-size: 1.4rem;
      color: #d6336c;
      text-align: right;
    }

    /* Open Animations */
    .envelope-wrapper.open .flap {
      transform: rotateX(180deg);
      z-index: 1;
    }

    .envelope-wrapper.open .seal {
      opacity: 0;
      pointer-events: none;
    }

    .envelope-wrapper.open .letter {
      transform: translateY(-130px);
      height: 310px;
      z-index: 6;
      overflow-y: auto;
    }

    .hint {
      margin-top: 25px;
      color: #8c1c42;
      font-size: 0.95rem;
      letter-spacing: 0.5px;
    }

    /* Floating Heart Particle Styling */
    .floating-heart {
      position: fixed;
      pointer-events: none;
      user-select: none;
      z-index: 10;
      animation: floatUp ease-out forwards;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) translateX(0) scale(0.6) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translateY(-350px) translateX(var(--drift)) scale(1.3) rotate(var(--spin));
        opacity: 0;
      }
    }
  </style>
</head>
<body>

  <div class="envelope-wrapper" id="envelope">
    <div class="flap"></div>
    <div class="seal">♥</div>
    <div class="pocket"></div>
    
    <div class="letter">
      <h2>My Dearest Megan,</h2>
      <p>
        Every day with you feels brighter and warmer than I ever imagined. Thank you for being my favorite person and my safe place.
      </p>
      <p>
        No matter where life takes us, my favorite place to be is right next to you.
      </p>
      <div class="signature">Forever yours, 
	Chris ♥</div>
    </div>
  </div>

  <div class="hint" id="hint">Click the envelope to open</div>

  <script>
    const envelope = document.getElementById('envelope');
    const hint = document.getElementById('hint');
    let heartInterval = null;

    function spawnHeart(originX, originY) {
      const heart = document.createElement('div');
      heart.classList.add('floating-heart');
      
      // Randomize heart symbol, color, size, and movement
      const symbols = ['♥', '❤', '💕', '💖'];
      const colors = ['#d6336c', '#e63946', '#ff4d6d', '#c9184a'];
      
      heart.textContent = symbols[Math.floor(Math.random() * symbols.length)];
      heart.style.color = colors[Math.floor(Math.random() * colors.length)];
      heart.style.fontSize = (Math.random() * 18 + 14) + 'px';
      
      // Start near the envelope center with slight horizontal spread
      heart.style.left = (originX + (Math.random() * 180 - 90)) + 'px';
      heart.style.top = originY + 'px';
      
      // Custom CSS variables for organic drift and rotation
      heart.style.setProperty('--drift', (Math.random() * 160 - 80) + 'px');
      heart.style.setProperty('--spin', (Math.random() * 60 - 30) + 'deg');
      
      const duration = Math.random() * 1.5 + 2;
      heart.style.animationDuration = duration + 's';

      document.body.appendChild(heart);

      // Remove element after animation finishes to keep the page fast
      setTimeout(() => heart.remove(), duration * 1000);
    }

    envelope.addEventListener('click', () => {
      const isOpen = envelope.classList.toggle('open');
      const rect = envelope.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 3;

      if (isOpen) {
        hint.textContent = 'Click again to close';
        // Initial burst of 15 hearts
        for (let i = 0; i < 15; i++) {
          setTimeout(() => spawnHeart(centerX, centerY), i * 60);
        }
        // Gentle continuous stream while open
        heartInterval = setInterval(() => spawnHeart(centerX, centerY), 450);
      } else {
        hint.textContent = 'Click the envelope to open';
        clearInterval(heartInterval);
      }
    });
  </script>

</body>
</html>
